DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
SESSION_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""

# Google Workspace SMTP (App Password from https://myaccount.google.com/apppasswords)
SMTP_USER="you@yourcompany.com"
SMTP_APP_PASSWORD="16-character app password"

# Set automatically by Vercel when Blob storage is enabled — do not set manually
# BLOB_READ_WRITE_TOKEN=
