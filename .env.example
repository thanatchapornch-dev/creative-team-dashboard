DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
SESSION_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""

# Resend (API key from https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
# Until a custom domain is verified in Resend, sending must use this address
RESEND_FROM="Creative & Production Dashboard <onboarding@resend.dev>"

# Set automatically by Vercel when Blob storage is enabled — do not set manually
# BLOB_READ_WRITE_TOKEN=
