DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
SESSION_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""

# Shared secret the Apps Script email relay must send to poll /api/email-queue
EMAIL_QUEUE_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(16).toString('hex'))\""

# Set automatically by Vercel when Blob storage is enabled — do not set manually
# BLOB_READ_WRITE_TOKEN=
